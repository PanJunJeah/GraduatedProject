# Docker 部署环境变量
COMPOSE_PROJECT_NAME=translation-platform

# 数据库
DB_HOST=postgres
DB_PORT=5432
DB_NAME=translatedb
DB_USER=postgres
DB_PASSWORD=postgres123

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# JWT (必须修改!)
JWT_SECRET=change_this_to_a_very_long_random_string_in_production
JWT_EXPIRATION=86400000

# AI 服务
AI_SERVICE_URL=http://ai-service:8000
